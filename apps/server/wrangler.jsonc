// Deployed automatically by Cloudflare Workers Builds on every push to main that touches
// apps/server/ or packages/ (build: npm install, deploy: npm -w apps/server run deploy).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fitd-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // the free plan only allows SQLite-backed Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "routes": [{ "pattern": "fitd-server.dorukplays.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
